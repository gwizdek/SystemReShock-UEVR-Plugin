<Application x:Class="SystemReShockInstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SystemReShockInstaller.ViewModels"
             xmlns:views="clr-namespace:SystemReShockInstaller.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
                <views:WelcomePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PathsViewModel}">
                <views:PathsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfirmViewModel}">
                <views:ConfirmPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResultViewModel}">
                <views:ResultPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LauncherViewModel}">
                <views:LauncherPage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

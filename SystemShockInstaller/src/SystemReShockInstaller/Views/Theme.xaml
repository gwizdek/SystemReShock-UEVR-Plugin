<!--
    Colours, font and text styles, taken from the game's options menu: bright green text and
    lines on black, yellow for the item under the pointer, a dark teal top bar and panels with a
    solid green header. Control templates are in Controls.xaml, page frames in Frames.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SystemReShockInstaller.Views"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- One size for all small text (help texts, details, errors, tooltips) on every page. -->
    <sys:Double x:Key="SmallFontSize">15</sys:Double>

    <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <views:BoolToMarkConverter x:Key="BoolToMark" />
    <views:BoolToMarkBrushConverter x:Key="BoolToMarkBrush" SuccessBrush="#00FF84" FailureBrush="#FF4A4A" />
    <views:UpperCaseConverter x:Key="UpperCase" />

    <!-- The game's menus use United Sans, a commercial font that cannot be shipped. Saira
         (SIL Open Font License, assets/fonts/OFL.txt) has the same squared shapes.
         HeadingFont: section labels, the top bar and panel headers, in bold at normal width like
         "TOGGLE CROUCH" in the game. UiFont: buttons and radio buttons, semi-condensed.
         BodyFont: running and small text, at normal width in Medium, as thinner and narrower
         letters are hard to read at small sizes. -->
    <FontFamily x:Key="HeadingFont">pack://application:,,,/Assets/Fonts/#Saira, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Saira SemiCondensed, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Assets/Fonts/#Saira, Segoe UI</FontFamily>

    <Color x:Key="GreenColor">#00FF84</Color>
    <Color x:Key="HighlightColor">#FFF22A</Color>

    <SolidColorBrush x:Key="WindowBackground" Color="#000000" />
    <!-- How much black covers the background image (assets/background.jpg): 0 shows it fully. -->
    <sys:Double x:Key="BackgroundDim">0.8</sys:Double>
    <!-- Slightly see-through, so the background shows faintly, as in the game's top bar. -->
    <SolidColorBrush x:Key="TopBarBackground" Color="#D90C211D" />
    <SolidColorBrush x:Key="TopBarLine" Color="#0CDC81" />
    <SolidColorBrush x:Key="PanelBackground" Color="#0F0F11" />
    <SolidColorBrush x:Key="InputBackground" Color="#050807" />
    <!-- Labels, headings, lines and the default button. -->
    <SolidColorBrush x:Key="Accent" Color="{StaticResource GreenColor}" />
    <!-- Running text, a little softer than the labels, as in the menu's description panel. -->
    <SolidColorBrush x:Key="TextPrimary" Color="#02F27F" />
    <SolidColorBrush x:Key="TextMuted" Color="#13A866" />
    <!-- Inactive parts: the unselected dashes under a menu value, input borders, disabled items. -->
    <SolidColorBrush x:Key="Dim" Color="#0C6D44" />
    <SolidColorBrush x:Key="Highlight" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="#000000" />
    <SolidColorBrush x:Key="Danger" Color="#FF4A4A" />

    <!-- Button frame and fill, measured from the RESET / APPLY / BACK buttons. ButtonChrome fades
         them out to the right. Under the mouse the frame turns yellow at the same brightness. -->
    <SolidColorBrush x:Key="ButtonEdge" Color="#04B865" />
    <SolidColorBrush x:Key="ButtonFill" Color="#04170D" />
    <SolidColorBrush x:Key="ButtonEdgeHover" Color="#B8AE1E" />
    <SolidColorBrush x:Key="ButtonFillHover" Color="#1A180A" />
    <SolidColorBrush x:Key="ButtonFillPressed" Color="#2E2A0F" />
    <!-- The page's main action keeps the same shape with a brighter frame and fill. -->
    <SolidColorBrush x:Key="PrimaryButtonFill" Color="#0A3D24" />

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A field or section name, written in capitals in the XAML, like "TOGGLE CROUCH" in the menu. -->
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Section heading like "USER INTERFACE" in the menu: yellow bold capitals over a 3 px line
         that fades from yellow through amber to nothing across the column. -->
    <LinearGradientBrush x:Key="SectionUnderline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F0F040" Offset="0" />
        <GradientStop Color="#BE982A" Offset="0.5" />
        <GradientStop Color="#684D22" Offset="0.85" />
        <GradientStop Color="#00684D22" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="SectionLabel" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource Highlight}"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Rectangle Height="3" Margin="0,3,0,0" Fill="{StaticResource SectionUnderline}"
                                   SnapsToDevicePixels="True" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
    </Style>

    <!-- The title of a setup step or result: the small text font in yellow. The pages show it in
         capitals through the UpperCase converter, like "POWERED BY UEVR". -->
    <Style x:Key="ItemTitle" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="Foreground" Value="{StaticResource Highlight}" />
    </Style>
    <Style x:Key="Error" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <!-- Most of the time there is no error; an empty line would push the page down. -->
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The breadcrumb in the top bar, like "OPTIONS > GRAPHICS": the first part is bold, the
         rest regular, as in the menu. -->
    <Style x:Key="Breadcrumb" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>

<!--
    A question or notice in the installer's style: black with a green border, a solid green header
    with the title in black capitals, the message, and the installer's buttons. It has no Windows
    title bar; drag it by the header. StyledDialogs creates it.
-->
<Window x:Class="SystemReShockInstaller.Views.StyledDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        BorderBrush="{StaticResource Accent}" BorderThickness="1"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel>
        <Border Background="{StaticResource Accent}" Padding="16,6" MouseLeftButtonDown="OnHeaderMouseDown">
            <TextBlock x:Name="TitleText" HorizontalAlignment="Center" TextWrapping="NoWrap"
                       FontFamily="{StaticResource HeadingFont}" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource OnAccent}" />
        </Border>
        <TextBlock x:Name="MessageText" Margin="28,24,28,24" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,0,28,20">
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Margin="0" Click="OnConfirm" />
            <Button x:Name="CancelButton" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>

<UserControl x:Class="SystemReShockInstaller.Views.PathsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SystemReShockInstaller.Views">
    <views:PageFrame Title="Choose folders">
        <views:PageFrame.ButtonBar>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Content="Next" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" IsDefault="True" />
            </StackPanel>
        </views:PageFrame.ButtonBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ContentControl Style="{StaticResource SectionLabel}" Content="UEVR FOLDER" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,8">
                    <Run Text="This mod needs UEVR nightly build" />
                    <Run Foreground="{StaticResource Highlight}" Text="1127" />
                    <Run Text="or newer. Download the latest nightly zip from" />
                    <Hyperlink NavigateUri="{Binding UevrNightlyUrl}" RequestNavigate="OnRequestNavigate">
                        <Run Text="github.com/praydog/UEVR-nightly" />
                    </Hyperlink>
                    <Run Text="(UEVR.zip under Assets), extract it to any folder, and select that folder here." />
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding UevrPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseUevrCommand}" />
                </Grid>
                <TextBlock Style="{StaticResource Error}" Text="{Binding UevrError}" />
                <HeaderedContentControl Style="{StaticResource InfoPanel}" Header="STEAM FRAME">
                    <TextBlock>
                        <Run Text="For Steam Frame compatibility we recommend the UEVR fork by joeyhodge, from" />
                        <Hyperlink NavigateUri="{Binding UevrSteamFrameForkUrl}" RequestNavigate="OnRequestNavigate">
                            <Run Text="github.com/joeyhodge/UEVR" />
                        </Hyperlink><Run Text="." />
                    </TextBlock>
                </HeaderedContentControl>

                <ContentControl Style="{StaticResource SectionLabel}" Margin="0,24,0,0" Content="SYSTEM SHOCK REMAKE FOLDER" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,8"
                           Text="The folder that contains SystemShock.exe, for example C:\Program Files (x86)\Steam\steamapps\common\System Shock Remake or C:\GOG Games\System Shock Remake." />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding ShowsStoreButtons, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Use Steam version" Command="{Binding UseSteamCommand}" Margin="0" ToolTip="{Binding SteamFolder}" />
                    <Button Content="Use GOG version" Command="{Binding UseGogCommand}" ToolTip="{Binding GogFolder}" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseGameCommand}" />
                </Grid>
                <TextBlock Style="{StaticResource Error}" Text="{Binding GameError}" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding DetectedStoreText}" />
            </StackPanel>
        </ScrollViewer>
    </views:PageFrame>
</UserControl>

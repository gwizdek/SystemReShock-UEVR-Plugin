<UserControl x:Class="SystemReShockInstaller.Views.ResultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SystemReShockInstaller.Views">
    <views:PageFrame Title="{Binding Headline}">
        <views:PageFrame.ButtonBar>
            <Button Content="{Binding FinishText}" Style="{StaticResource PrimaryButton}" Command="{Binding FinishCommand}" IsDefault="True" />
        </views:PageFrame.ButtonBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="{StaticResource SmallFontSize}" FontWeight="Bold"
                                           Text="{Binding Succeeded, Converter={StaticResource BoolToMark}}"
                                           Foreground="{Binding Succeeded, Converter={StaticResource BoolToMarkBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource ItemTitle}" Text="{Binding Title, Converter={StaticResource UpperCase}}" />
                                    <TextBlock Style="{StaticResource Error}" Text="{Binding Error}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0">
                    <Run Text="Profile folder: " /><Run Text="{Binding ProfileTargetDir, Mode=OneWay}" />
                    <LineBreak />
                    <Run Text="Pak folder: " /><Run Text="{Binding PaksTargetDir, Mode=OneWay}" />
                </TextBlock>

                <StackPanel Visibility="{Binding Succeeded, Converter={StaticResource BoolToVisibility}}" Margin="0,22,0,0">
                    <ContentControl Style="{StaticResource SectionLabel}" Content="NEXT STEPS" />
                    <ItemsControl ItemsSource="{Binding NextSteps}" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Dim}" BorderThickness="2,0,0,0" Padding="12,1,0,1" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </views:PageFrame>
</UserControl>

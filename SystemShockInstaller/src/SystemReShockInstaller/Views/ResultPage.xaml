<UserControl x:Class="SystemReShockInstaller.Views.ResultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="28,28,28,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="{Binding Headline}" />

                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="Bold"
                                           Text="{Binding Succeeded, Converter={StaticResource BoolToMark}}"
                                           Foreground="{Binding Succeeded, Converter={StaticResource BoolToMarkBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource Error}" Text="{Binding Error}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12">
                    <Run Text="Profile folder: " /><Run Text="{Binding ProfileTargetDir, Mode=OneWay}" />
                    <LineBreak />
                    <Run Text="Pak folder: " /><Run Text="{Binding PaksTargetDir, Mode=OneWay}" />
                </TextBlock>

                <StackPanel Visibility="{Binding Succeeded, Converter={StaticResource BoolToVisibility}}" Margin="0,20,0,0">
                    <TextBlock FontWeight="SemiBold" Text="Next steps" />
                    <ItemsControl ItemsSource="{Binding NextSteps}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2,0,0">
                                    <Run Text="• " /><Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource ButtonBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding FinishText}" Style="{StaticResource PrimaryButton}" Command="{Binding FinishCommand}" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

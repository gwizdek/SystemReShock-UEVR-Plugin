<UserControl x:Class="SystemReShockInstaller.Views.LauncherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SystemReShockInstaller.Views">
    <views:PageFrame Title="Launcher" ShowsArtwork="True">
        <views:PageFrame.ButtonBar>
            <StackPanel Orientation="Horizontal">
                <Button Content="Reinstall" Command="{Binding ReinstallCommand}" />
                <Button Content="Uninstall" Command="{Binding UninstallCommand}" />
                <Button Content="Exit" Command="{Binding ExitCommand}" />
                <Button Content="Launch game" Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}" IsDefault="True" />
            </StackPanel>
        </views:PageFrame.ButtonBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ContentControl Style="{StaticResource SectionLabel}" Content="SYSTEM SHOCK REMAKE VR MOD" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" views:VersionHighlight.Text="{Binding InstalledVersionText}" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding StoreText}" />

                <ContentControl Style="{StaticResource SectionLabel}" Margin="0,24,0,12" Content="VR RUNTIME" />
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanChangeRuntime}">
                    <RadioButton Content="OpenXR" GroupName="Runtime" IsChecked="{Binding IsOpenXr}" />
                    <RadioButton Content="OpenVR (SteamVR)" GroupName="Runtime" IsChecked="{Binding IsOpenVr}" Margin="32,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{Binding DelayText}" />

                <HeaderedContentControl Style="{StaticResource InfoPanel}" Header="STATUS" Margin="0,22,0,0">
                    <TextBlock Text="{Binding Status}" />
                </HeaderedContentControl>
            </StackPanel>
        </ScrollViewer>
    </views:PageFrame>
</UserControl>

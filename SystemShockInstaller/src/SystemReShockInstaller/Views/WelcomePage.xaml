<UserControl x:Class="SystemReShockInstaller.Views.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SystemReShockInstaller.Views">
    <views:PageFrame Title="Welcome" ShowsArtwork="True">
        <views:PageFrame.ButtonBar>
            <StackPanel Orientation="Horizontal">
                <Button Content="Uninstall" Command="{Binding UninstallCommand}"
                        Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" />
                <Button Content="Launch game" Command="{Binding LaunchCommand}"
                        Visibility="{Binding IsUpdateOffer, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{Binding NextText}" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" IsDefault="True" />
            </StackPanel>
        </views:PageFrame.ButtonBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ContentControl Style="{StaticResource SectionLabel}" Content="SYSTEM SHOCK REMAKE VR MOD" />
                <TextBlock Margin="0,10,0,0"
                           Text="Welcome. This setup installs the UEVR profile and the game files that turn System Shock Remake into a full roomscale VR game with motion controls." />
                <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0"
                           Text="You will be asked for two folders: where UEVR is extracted, and where System Shock Remake is installed. Nothing is changed until you confirm." />
                <HeaderedContentControl Style="{StaticResource InfoPanel}" Header="NOTICE"
                                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock views:VersionHighlight.Text="{Binding Notice}" />
                </HeaderedContentControl>
            </StackPanel>
        </ScrollViewer>
    </views:PageFrame>
</UserControl>

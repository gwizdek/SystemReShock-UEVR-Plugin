<UserControl x:Class="SystemReShockInstaller.Views.ConfirmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SystemReShockInstaller.Views">
    <views:PageFrame Title="Ready to install">
        <views:PageFrame.Status>
            <TextBlock Style="{StaticResource Label}" FontSize="15" Foreground="{StaticResource Highlight}" Text="INSTALLING..."
                       Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />
        </views:PageFrame.Status>
        <views:PageFrame.ButtonBar>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Content="Install" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" IsDefault="True" />
            </StackPanel>
        </views:PageFrame.ButtonBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="Setup will do the following. Press Install to continue or Cancel to leave everything unchanged." />

                <!-- One entry per step, with a dim bar on the left like the menu's item list. -->
                <ItemsControl ItemsSource="{Binding Actions}" Margin="0,16,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Dim}" BorderThickness="2,0,0,0" Padding="12,2,0,2" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ItemTitle}" Text="{Binding Title, Converter={StaticResource UpperCase}}" />
                                    <ItemsControl ItemsSource="{Binding Details}" Margin="0,2,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource Muted}" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Error}" Text="{Binding BlockMessage}" />
            </StackPanel>
        </ScrollViewer>
    </views:PageFrame>
</UserControl>

<Window x:Class="SystemReShockInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="920" Height="790"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <!-- The game's ring background, dimmed by a black layer, behind every page. -->
        <Image Source="pack://application:,,,/Assets/background.jpg" Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Rectangle Fill="Black" Opacity="{StaticResource BackgroundDim}" />
        <ContentControl Content="{Binding CurrentPage}" />
    </Grid>
</Window>

    { "action": "dpad_right", "path": "/user/hand/left/input/dpad_right/click" },

    { "action": "systembutton", "path": "/user/hand/left/input/system/click" },
    { "action": "systembutton", "path": "/user/hand/right/input/system/click" }
  ]
}
